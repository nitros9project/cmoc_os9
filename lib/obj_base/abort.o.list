                      (      ../abort.as):00001         * Adapted from cmoc_os9/lib/todo/abort.as for the live cmoc_os9 ABI.
                      (      ../abort.as):00002         *
                      (      ../abort.as):00003         * The original Kreider abort path tried to dump process memory through
                      (      ../abort.as):00004         * startup-module symbols. The live CMOC runtime does not use that startup
                      (      ../abort.as):00005         * model, so the practical libc contract here is simply: do not return.
                      (      ../abort.as):00006         
                      (      ../abort.as):00007                             use       ../include/os9.d ; shared OS-9 service constants
                      ( ../include/os9.d):00001         * Shared assembler-side OS-9 service, error, and status constants.
                      ( ../include/os9.d):00002         
     0000             ( ../include/os9.d):00003         F_Link              equ       $00       ; OS-9 link existing module
     0001             ( ../include/os9.d):00004         F_Load              equ       $01       ; OS-9 load module from disk
     0002             ( ../include/os9.d):00005         F_UnLink            equ       $02       ; OS-9 release linked module
     0003             ( ../include/os9.d):00006         F_Fork              equ       $03       ; OS-9 fork system call
     0004             ( ../include/os9.d):00007         F_Wait              equ       $04       ; OS-9 wait system call
     0005             ( ../include/os9.d):00008         F_Chain             equ       $05       ; OS-9 chain system call
     0006             ( ../include/os9.d):00009         F_Exit              equ       $06       ; OS-9 exit system call
     0007             ( ../include/os9.d):00010         F_Mem               equ       $07       ; OS-9 memory-allocation service
     0008             ( ../include/os9.d):00011         F_Send              equ       $08       ; OS-9 send-signal system call
     0009             ( ../include/os9.d):00012         F_Icpt              equ       $09       ; OS-9 intercept-vector service
     000A             ( ../include/os9.d):00013         F_Sleep             equ       $0A       ; OS-9 sleep system call
     000C             ( ../include/os9.d):00014         F_ID                equ       $0C       ; OS-9 process identity service
     000D             ( ../include/os9.d):00015         F_SPrior            equ       $0D       ; OS-9 set-priority system call
     000F             ( ../include/os9.d):00016         F_PErr              equ       $0F       ; OS-9 print-error service
     0015             ( ../include/os9.d):00017         F_Time              equ       $15       ; OS-9 read system time service
     0016             ( ../include/os9.d):00018         F_STime             equ       $16       ; OS-9 set system time service
     0017             ( ../include/os9.d):00019         F_CRC               equ       $17       ; OS-9 CRC helper service
