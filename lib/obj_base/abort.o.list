     0083             ( ../include/os9.d):00021         I_Create            equ       $83       ; OS-9 create path call
     0084             ( ../include/os9.d):00022         I_Open              equ       $84       ; OS-9 open path call
     0085             ( ../include/os9.d):00023         I_MakDir            equ       $85       ; OS-9 make-directory call
     0086             ( ../include/os9.d):00024         I_ChgDir            equ       $86       ; OS-9 change-directory call
     0088             ( ../include/os9.d):00025         I_Seek              equ       $88       ; OS-9 direct seek call
