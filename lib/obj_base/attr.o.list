                      (       ../attr.as):00004         __os_ss_attr        EXPORT              ; export file-attribute SetStat helper
                      (       ../attr.as):00005         
                      (       ../attr.as):00006         _osret              EXTERNAL            ; common successful return helper
                      (       ../attr.as):00007         
                      (       ../attr.as):00008                             section   code      ; begin code section
                      (       ../attr.as):00009         
0000                  (       ../attr.as):00010         __os_ss_attr
0000 3460             (       ../attr.as):00011                             pshs      y,u       ; preserve registers across helper calls
0002 3270             (       ../attr.as):00012                             leas      -16,s     ; reserve temporary file descriptor buffer
0004 8602             (       ../attr.as):00013                             lda       #S_IWRITE ; first try opening as a regular writable file
0006 8D35             (       ../attr.as):00014                             bsr       openfile  ; open the path and fetch its descriptor sector
0008 2406             (       ../attr.as):00015                             bcc       openok    ; continue if the open/GetStat sequence succeeded
000A 8682             (       ../attr.as):00016                             lda       #S_DIR|S_IWRITE ; retry as a writable directory path
000C 8D2F             (       ../attr.as):00017                             bsr       openfile  ; attempt directory open/GetStat sequence
000E 2525             (       ../attr.as):00018                             bcs       goexit    ; give up if both open attempts failed
0010                  (       ../attr.as):00019         openok
0010 3422             (       ../attr.as):00020                             pshs      a,y       ; save open path id and returned owner/group info
0012 103F0C           (       ../attr.as):00021                             os9       F_ID      ; fetch current process user id for permission check
0015 108C0000         (       ../attr.as):00022                             cmpy      #0        ; user 0 bypasses owner check
0019 2709             (       ../attr.as):00023                             beq       userok    ; superuser may update attributes directly
001B C6D6             (       ../attr.as):00024                             ldb       #E_FNA    ; preload permission-denied style error code
001D 10AC01           (       ../attr.as):00025                             cmpy      1,x       ; compare process user id against file owner id
0020 1A01             (       ../attr.as):00026                             orcc      #1        ; force carry set for mismatch/error return
0022 2611             (       ../attr.as):00027                             bne       goexit    ; reject attribute change for non-owner
0024 E6E81C           (       ../attr.as):00028         userok              ldb       28,s      ; load requested attribute byte from stack
0027 E784             (       ../attr.as):00029                             stb       ,x        ; patch attribute field in descriptor buffer
0029 3522             (       ../attr.as):00030                             puls      a,y       ; restore path id and saved Y value
002B C60F             (       ../attr.as):00031                             ldb       #SS_FD    ; request descriptor-sector update
002D 103F8E           (       ../attr.as):00032                             os9       I_SetStt  ; write the modified descriptor back to disk
0030 2503             (       ../attr.as):00033                             bcs       goexit    ; return error if SetStat failed
0032 103F8F           (       ../attr.as):00034                             os9       I_Close   ; close the temporary path descriptor
0035                  (       ../attr.as):00035         goexit
0035 32E810           (       ../attr.as):00036                             leas      16,s      ; discard temporary file descriptor buffer
0038 3560             (       ../attr.as):00037                             puls      y,u       ; restore caller's registers
003A 160000           (       ../attr.as):00038                             lbra      _osret    ; return through common status helper
                      (       ../attr.as):00039         
003D                  (       ../attr.as):00040         openfile
003D AEE818           (       ../attr.as):00041                             ldx       24,s      ; load pathname pointer argument
0040 103F84           (       ../attr.as):00042                             os9       I_Open    ; open the path using mode in A
0043 2401             (       ../attr.as):00043                             bcc       getfd     ; fetch descriptor contents on success
0045 39               (       ../attr.as):00044                             rts                 ; return with OS-9 carry/error status intact
                      (       ../attr.as):00045         
0046                  (       ../attr.as):00046         getfd
0046 3062             (       ../attr.as):00047                             leax      2,s       ; point X at local descriptor-sector buffer
0048 108E0010         (       ../attr.as):00048                             ldy       #16       ; request the 16-byte descriptor sector
004C C60F             (       ../attr.as):00049                             ldb       #SS_FD    ; ask GetStat for descriptor contents
004E 103F8D           (       ../attr.as):00050                             os9       I_GetStt  ; populate local descriptor buffer
0051 39               (       ../attr.as):00051                             rts                 ; return with carry reflecting GetStat status
