     0001             (      ../chmod.as):00015         FD_Own              equ       1         ; define constant as 1
     0010             (      ../chmod.as):00016         Bufsize             equ       16        ; define constant as 16
                      (      ../chmod.as):00017         
0000 3460             (      ../chmod.as):00018         _chmod              pshs      y,u       ; save Y,U on the hardware stack
0002 3270             (      ../chmod.as):00019                             leas      -Bufsize,s ; adjust S using -Bufsize,s
                      (      ../chmod.as):00020         
