                      (     ../cludiv.as):00069         
                      (     ../cludiv.as):00070         * set up our stack
004B                  (     ../cludiv.as):00071         div2
004B EC00             (     ../cludiv.as):00072                             ldd       0,x       ; load D from indexed value 0,x
004D AE02             (     ../cludiv.as):00073                             ldx       2,x       ; load X from indexed value 2,x
004F 3416             (     ../cludiv.as):00074                             pshs      d,x       ; save D,X on the hardware stack
0051 CC0000           (     ../cludiv.as):00075                             ldd       #0        ; load D from immediate value 0
0054 3406             (     ../cludiv.as):00076                             pshs      d         ; save D on the hardware stack
