0072                  (     ../cludiv.as):00092         div51
0072 A760             (     ../cludiv.as):00093                             sta       0,s       ; store A to stack-relative value 0,s
0074 2036             (     ../cludiv.as):00094                             bra       check     ; branch unconditionally to check
                      (     ../cludiv.as):00095         
                      (     ../cludiv.as):00096         * subtract the divisor from the dividend
0076                  (     ../cludiv.as):00097         div6
0076 EC6C             (     ../cludiv.as):00098                             ldd       12,s      ; load D from stack-relative value 12,s
0078 A364             (     ../cludiv.as):00099                             subd      4,s       ; subtract stack-relative value 4,s from D
007A ED6C             (     ../cludiv.as):00100                             std       12,s      ; store D to stack-relative value 12,s
007C EC6A             (     ../cludiv.as):00101                             ldd       10,s      ; load D from stack-relative value 10,s
007E E263             (     ../cludiv.as):00102                             sbcb      3,s       ; subtract stack-relative value 3,s from B
0080 A262             (     ../cludiv.as):00103                             sbca      2,s       ; subtract stack-relative value 2,s from A
0082 ED6A             (     ../cludiv.as):00104                             std       10,s      ; store D to stack-relative value 10,s
0084 2412             (     ../cludiv.as):00105                             bcc       div7      ; branch if carry is clear to div7
0086 EC6C             (     ../cludiv.as):00106                             ldd       12,s      ; load D from stack-relative value 12,s
0088 E364             (     ../cludiv.as):00107                             addd      4,s       ; add stack-relative value 4,s into D
008A ED6C             (     ../cludiv.as):00108                             std       12,s      ; store D to stack-relative value 12,s
008C EC6A             (     ../cludiv.as):00109                             ldd       10,s      ; load D from stack-relative value 10,s
008E E963             (     ../cludiv.as):00110                             adcb      3,s       ; add stack-relative value 3,s into B
0090 A962             (     ../cludiv.as):00111                             adca      2,s       ; add stack-relative value 2,s into A
0092 ED6A             (     ../cludiv.as):00112                             std       10,s      ; store D to stack-relative value 10,s
0094 1CFE             (     ../cludiv.as):00113                             andcc     #^Carry   ; clear condition-code bits with mask #^Carry
0096 2002             (     ../cludiv.as):00114                             bra       div8      ; branch unconditionally to div8
