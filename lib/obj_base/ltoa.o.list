                      (       ../ltoa.as):00012         _reverse            EXTERNAL            ; import external symbol
                      (       ../ltoa.as):00013         divDWordDWord       EXTERNAL            ; import external symbol
                      (       ../ltoa.as):00014         isDWordZero         EXTERNAL            ; import external symbol
                      (       ../ltoa.as):00015         modDWordDWord       EXTERNAL            ; import external symbol
                      (       ../ltoa.as):00016         
