000E AE66             (      ../ltol3.as):00015                             ldx       6,s       ; load X from stack-relative value 6,s
0010 EC02             (      ../ltol3.as):00016                             ldd       2,x       ; load D from indexed value 2,x
0012 EDC4             (      ../ltol3.as):00017                             std       ,u        ; store D to memory pointed to by U
