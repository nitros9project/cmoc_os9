0000 3460             (    ../memccpy.as):00008                             pshs      y,u       ; save Y,U on the hardware stack
0002 EE68             (    ../memccpy.as):00009                             ldu       8,s       ; load U from stack-relative value 8,s
0004 AE66             (    ../memccpy.as):00010                             ldx       6,s       ; load X from stack-relative value 6,s
