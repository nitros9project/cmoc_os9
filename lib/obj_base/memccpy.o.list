000B A6C0             (    ../memccpy.as):00013         Loop_01             lda       ,u+       ; load A from memory pointed to by U, then advance U
000D A780             (    ../memccpy.as):00014                             sta       ,x+       ; store A to memory pointed to by X, then advance X
000F A16B             (    ../memccpy.as):00015                             cmpa      11,s      ; compare A against stack-relative value 11,s
0011 2604             (    ../memccpy.as):00016                             bne       BranchTarget_01 ; branch if not equal to BranchTarget_01
0013 1F30             (    ../memccpy.as):00017                             tfr       u,d       ; transfer U,D
