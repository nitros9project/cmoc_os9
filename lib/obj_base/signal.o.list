                      (     ../signal.as):00028         * signal(sig, func)
0000                  (     ../signal.as):00029         _sigint
0000                  (     ../signal.as):00030         _signal
0000 EC62             (     ../signal.as):00031                             ldd       2,s       ; get the signal number
0002 5D               (     ../signal.as):00032                             tstb                ; lsb 0?
0003 2707             (     ../signal.as):00033                             beq       sigerr    ; signal 0 can't be caught or ignored
0005 4D               (     ../signal.as):00034                             tsta                ; greater than 255?
0006 2604             (     ../signal.as):00035                             bne       sigerr    ; branch if not equal to sigerr
0008 8D32             (     ../signal.as):00036                             bsr       lookup    ; find a suitable entry
000A 2604             (     ../signal.as):00037                             bne       signal10  ; branch if entry found
                      (     ../signal.as):00038         
000C                  (     ../signal.as):00039         sigerr
000C CCFFFF           (     ../signal.as):00040                             ldd       #-1       ; error indication
000F 39               (     ../signal.as):00041                             rts                 ; return to caller
                      (     ../signal.as):00042         
0010                  (     ../signal.as):00043         signal10
0010 EC01             (     ../signal.as):00044                             ldd       func,x    ; get the old entry function
0012 3406             (     ../signal.as):00045                             pshs      d         ; save it
0014 EC66             (     ../signal.as):00046                             ldd       6,s       ; get the new function
0016 ED01             (     ../signal.as):00047                             std       func,x    ; store in the structure
0018 2604             (     ../signal.as):00048                             bne       signal20  ; if not 0 branch
                      (     ../signal.as):00049         
                      (     ../signal.as):00050         * the new 'function' is reset (0)
001A 6F84             (     ../signal.as):00051                             clr       sig,x     ; reset the signal byte
001C                  (     ../signal.as):00052         sigexit
001C 3586             (     ../signal.as):00053                             puls      d,pc      ; return the old entry
                      (     ../signal.as):00054         
                      (     ../signal.as):00055         * value for 'func' is 1 or a real address - set it
001E                  (     ../signal.as):00056         signal20
001E E665             (     ../signal.as):00057                             ldb       5,s       ; get the signal
0020 E784             (     ../signal.as):00058                             stb       sig,x     ; store it
0022 6DA90000         (     ../signal.as):00059                             tst       _flag,y   ; have we intercepted before?
0026 26F4             (     ../signal.as):00060                             bne       sigexit   ; yes - no more to do
                      (     ../signal.as):00061         
0028 1E23             (     ../signal.as):00062                             exg       y,u       ; set the local storage into u
002A 308D003C         (     ../signal.as):00063                             leax      intrupt,pcr ; get the address of the interrupt routine
002E 103F09           (     ../signal.as):00064                             os9       F_Icpt    ; invoke OS-9 system call F_Icpt
0031 1E23             (     ../signal.as):00065                             exg       y,u       ; reset local storage into y
0033 3506             (     ../signal.as):00066                             puls      d         ; get the old value into d
0035 25D5             (     ../signal.as):00067                             bcs       sigerr    ; error?
0037 6CA90000         (     ../signal.as):00068                             inc       _flag,y   ; indicate that we've done it
003B 39               (     ../signal.as):00069                             rts                 ; all done
                      (     ../signal.as):00070         
                      (     ../signal.as):00071         * Table lookup function:
                      (     ../signal.as):00072         *
                      (     ../signal.as):00073         * find an entry in the table whose 'sig' matches the b reg.
                      (     ../signal.as):00074         * failing that, the first empty entry
                      (     ../signal.as):00075         * failing that, zero
                      (     ../signal.as):00076         * return result in x reg. and set the z bit accordingly
003C                  (     ../signal.as):00077         lookup
003C 6FE2             (     ../signal.as):00078                             clr       ,-s       ; set up a null
003E 6FE2             (     ../signal.as):00079                             clr       ,-s       ; 'empty' pointer
0040 30A90000         (     ../signal.as):00080                             leax      _etable,y ; get table end address
0044 3410             (     ../signal.as):00081                             pshs      x         ; save it
0046 30A90000         (     ../signal.as):00082                             leax      _table,y  ; start at the beginning
                      (     ../signal.as):00083         
004A                  (     ../signal.as):00084         loop
004A ACE4             (     ../signal.as):00085                             cmpx      ,s        ; end yet?
004C 2717             (     ../signal.as):00086                             beq       eloop     ; yes - exit loop
004E E184             (     ../signal.as):00087                             cmpb      sig,x     ; match?
0050 2605             (     ../signal.as):00088                             bne       signal30  ; no - continue
0052 3264             (     ../signal.as):00089                             leas      4,s       ; clean up stack
0054 1CFB             (     ../signal.as):00090                             andcc     #^Zero    ; indicate success
0056 39               (     ../signal.as):00091                             rts                 ; and return
                      (     ../signal.as):00092         
0057                  (     ../signal.as):00093         signal30
0057 A684             (     ../signal.as):00094                             lda       sig,x     ; if the entry is not empty
0059 AA62             (     ../signal.as):00095                             ora       2,s       ; or the 'empty' pointer
005B AA63             (     ../signal.as):00096                             ora       3,s       ; is not null
005D 2602             (     ../signal.as):00097                             bne       signal40  ; then continue
005F AF62             (     ../signal.as):00098                             stx       2,s       ; else save address of empty entry
                      (     ../signal.as):00099         
0061                  (     ../signal.as):00100         signal40
0061 3003             (     ../signal.as):00101                             leax      entsiz,x  ; bump to next
0063 20E5             (     ../signal.as):00102                             bra       loop      ; and round again
                      (     ../signal.as):00103         
0065                  (     ../signal.as):00104         eloop
                      (     ../signal.as):00105         * traversed table without finding a match
0065 AE62             (     ../signal.as):00106                             ldx       2,s       ; get the empty entry pointer
0067 3264             (     ../signal.as):00107                             leas      4,s       ; clean the stack
0069 39               (     ../signal.as):00108                             rts                 ; return to caller
                      (     ../signal.as):00109         
                      (     ../signal.as):00110         * Entry point for all received signals.
                      (     ../signal.as):00111         * If an entry is found matching the signal then
                      (     ../signal.as):00112         *   if the function address is not 1 then execute it
                      (     ../signal.as):00113         *   then rti
                      (     ../signal.as):00114         * else
                      (     ../signal.as):00115         *   exit with the signal as status
006A                  (     ../signal.as):00116         intrupt
006A 31C4             (     ../signal.as):00117                             leay      ,u        ; point to the data
006C 8DCE             (     ../signal.as):00118                             bsr       lookup    ; branch to subroutine to lookup
006E 2706             (     ../signal.as):00119                             beq       intr10    ; any entry returned?
0070 3410             (     ../signal.as):00120                             pshs      x         ; save the entry pointer
0072 AE01             (     ../signal.as):00121                             ldx       func,x    ; get the function address
0074 2603             (     ../signal.as):00122                             bne       intr20    ; empty entry?
                      (     ../signal.as):00123         
                      (     ../signal.as):00124         * no matching entry - simulate condition of no 'intercept'
0076                  (     ../signal.as):00125         intr10
0076 103F06           (     ../signal.as):00126                             os9       F_Exit    ; status still in B reg.
                      (     ../signal.as):00127         
0079                  (     ../signal.as):00128         intr20
0079 8C0001           (     ../signal.as):00129                             cmpx      #1        ; is it 'ignore'?
007C 2603             (     ../signal.as):00130                             bne       intr30    ; no - execute
007E 3262             (     ../signal.as):00131                             leas      2,s       ; reset stack
0080 3B               (     ../signal.as):00132                             rti                 ; and resume
                      (     ../signal.as):00133         
0081                  (     ../signal.as):00134         intr30
0081 4F               (     ../signal.as):00135                             clra                ; clear the MSB of the signal arg
0082 3406             (     ../signal.as):00136                             pshs      d         ; put it on stack for the function
0084 AD84             (     ../signal.as):00137                             jsr       ,x        ; go run the function
0086 3516             (     ../signal.as):00138                             puls      d,x       ; get the entry pointer back
0088 4F               (     ../signal.as):00139                             clra                ; clear A
0089 5F               (     ../signal.as):00140                             clrb                ; clear B
008A A784             (     ../signal.as):00141                             sta       sig,x     ; clear the entry
008C ED01             (     ../signal.as):00142                             std       func,x    ; and its func address
008E 3B               (     ../signal.as):00143                             rti                 ; and that's it
                      (     ../signal.as):00144         
