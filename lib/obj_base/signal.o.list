                      (     ../signal.as):00001         * Adapted from cmoc_os9/lib/todo/signal.as for the live cmoc_os9 ABI.
                      (     ../signal.as):00002         *
                      (     ../signal.as):00003         * 'signal' and 'intercept' are definitely incompatible and use of both in a
                      (     ../signal.as):00004         * program will have undefined results.  Both modules export _sigint so the
                      (     ../signal.as):00005         * linker reports an entry-name clash if an attempt is made to use both.
                      (     ../signal.as):00006         
                      (     ../signal.as):00007                             section   bss       ; begin bss section
                      (     ../signal.as):00008         
     0014             (     ../signal.as):00009         MAXENTS             equ       20        ; maximum simultaneous traps
     0004             (     ../signal.as):00010         Zero                equ       %00000100 ; define constant as %00000100
     0000             (     ../signal.as):00011         sig                 equ       0         ; define constant as 0
     0001             (     ../signal.as):00012         func                equ       1         ; define constant as 1
     0003             (     ../signal.as):00013         entsiz              equ       3         ; define constant as 3
                      (     ../signal.as):00014         
0000                  (     ../signal.as):00015         _table              rmb       entsiz*MAXENTS ; reserve entsiz*MAXENTS bytes
003C                  (     ../signal.as):00016         _etable             rmb       0         ; reserve 0 bytes
003C                  (     ../signal.as):00017         _flag               rmb       1         ; reserve 1 bytes
                      (     ../signal.as):00018         
                      (     ../signal.as):00019                             endsect             ; end current section
