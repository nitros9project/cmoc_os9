0000 3460             (       ../stat.as):00012                             pshs      y,u       ; preserve Y and U across the system call
0002 A669             (       ../stat.as):00013                             lda       9,s       ; load path number argument
0004 E667             (       ../stat.as):00014                             ldb       7,s       ; load requested GetStat code
0006 272F             (       ../stat.as):00015                             beq       L003c     ; SS_Opt uses only X as parameter
0008 C101             (       ../stat.as):00016                             cmpb      #SS_Ready ; check for simple status query using registers only
000A 272D             (       ../stat.as):00017                             beq       L003e     ; issue call directly for single-register forms
000C C102             (       ../stat.as):00018                             cmpb      #SS_Size  ; query 32-bit file size
000E 2714             (       ../stat.as):00019                             beq       L0024     ; handle X/U return pair specially
0010 C105             (       ../stat.as):00020                             cmpb      #SS_Pos   ; query 32-bit file position
0012 2710             (       ../stat.as):00021                             beq       L0024     ; handle X/U return pair specially
0014 C106             (       ../stat.as):00022                             cmpb      #SS_EOF   ; check end-of-file status
0016 2721             (       ../stat.as):00023                             beq       L003e     ; direct GetStat with no pointer setup
0018 C10E             (       ../stat.as):00024                             cmpb      #SS_DevNm ; request device name string
001A 271B             (       ../stat.as):00025                             beq       L003c     ; load X only before the call
001C C10F             (       ../stat.as):00026                             cmpb      #SS_FD    ; request file descriptor sector
001E 2714             (       ../stat.as):00027                             beq       L0039     ; load both X and Y before the call
0020 C6D0             (       ../stat.as):00028                             ldb       #E_UnkSvc ; reject unsupported traditional codes
0022 2018             (       ../stat.as):00029                             bra       gsbye     ; return error through shared exit
0024 103F8D           (       ../stat.as):00030         L0024               os9       I_GetStt  ; perform size/position GetStat call
0027 2513             (       ../stat.as):00031                             bcs       gsbye     ; return immediately if OS-9 signaled an error
0029 AFF80A           (       ../stat.as):00032         L002e               stx       [10,s]    ; store high word of 32-bit result through p1
002C AE6A             (       ../stat.as):00033                             ldx       10,s      ; reload destination pointer
002E EF02             (       ../stat.as):00034                             stu       2,x       ; store low word of 32-bit result through p1
0030 5F               (       ../stat.as):00035                             clrb                ; clear low byte of success return value
0031 4F               (       ../stat.as):00036                             clra                ; clear high byte of success return value
0032 2008             (       ../stat.as):00037                             bra       gsbye     ; finish through shared return path
0034 10AE6C           (       ../stat.as):00038         L0039               ldy       12,s      ; load byte-count/aux pointer argument for SS_FD
0037 AE6A             (       ../stat.as):00039         L003c               ldx       10,s      ; load primary buffer pointer argument
0039 103F8D           (       ../stat.as):00040         L003e               os9       I_GetStt  ; issue the requested GetStat call
003C 3560             (       ../stat.as):00041         gsbye               puls      y,u       ; restore preserved registers
003E 160000           (       ../stat.as):00042                             lbra      _sysret   ; return using shared status-to-C helper
