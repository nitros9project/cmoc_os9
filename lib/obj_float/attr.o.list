     000C             (       ../attr.as):00008         F_ID                equ       $0C       ; query current process identity
     0084             (       ../attr.as):00009         I_Open              equ       $84       ; open an existing path
     008D             (       ../attr.as):00010         I_GetStt            equ       $8D       ; GetStat system call
     008E             (       ../attr.as):00011         I_SetStt            equ       $8E       ; SetStat system call
     008F             (       ../attr.as):00012         I_Close             equ       $8F       ; close path descriptor
