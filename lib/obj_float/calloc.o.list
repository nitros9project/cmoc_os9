001A 301F             (     ../calloc.as):00023                             leax      -1,x      ; decrement the remaining byte count
001C 26FA             (     ../calloc.as):00024                             bne       Loop_01   ; continue zero-filling until the full block has been cleared
001E 3262             (     ../calloc.as):00025         BranchTarget_01     leas      2,s       ; adjust S using 2,s
