0000 3440             (     ../calloc.as):00011                             pshs      u         ; save U on the hardware stack
0002 EC64             (     ../calloc.as):00012                             ldd       4,s       ; load D from stack-relative value 4,s
0004 AE66             (     ../calloc.as):00013                             ldx       6,s       ; load X from stack-relative value 6,s
0006 3410             (     ../calloc.as):00014                             pshs      x         ; preserve the element count while computing the allocation size
0008 170000           (     ../calloc.as):00015                             lbsr      ccmult    ; multiply the element count by the element size
000B 3406             (     ../calloc.as):00016                             pshs      d         ; save the total allocation size for the post-malloc clear loop
000D 170000           (     ../calloc.as):00017                             lbsr      _malloc   ; long branch to subroutine to _malloc
0010 ED7E             (     ../calloc.as):00018                             std       -2,s      ; keep the malloc result on the stack as the function return value
0012 270A             (     ../calloc.as):00019                             beq       BranchTarget_01 ; skip the clear loop when malloc returned NULL
0014 AEE4             (     ../calloc.as):00020                             ldx       ,s        ; load X from memory pointed to by S
0016 1F03             (     ../calloc.as):00021                             tfr       d,u       ; copy the allocated block pointer into U for byte-by-byte clearing
