0018 5D               (    ../cshifts.as):00032                             tstb                ; test B and update condition codes
0019 2707             (    ../cshifts.as):00033                             beq       BranchTarget_01 ; branch if equal/zero to BranchTarget_01
001B 6863             (    ../cshifts.as):00034         Loop_03             asl       3,s       ; shift stack-relative value 3,s left by one bit
001D 6962             (    ../cshifts.as):00035                             rol       2,s       ; rotate stack-relative value 2,s left through carry
001F 5A               (    ../cshifts.as):00036                             decb                ; decrement B
0020 26F9             (    ../cshifts.as):00037                             bne       Loop_03   ; branch if not equal to Loop_03
0022 EC62             (    ../cshifts.as):00038         BranchTarget_01     ldd       2,s       ; load D from stack-relative value 2,s
0024 3406             (    ../cshifts.as):00039                             pshs      d         ; save D on the hardware stack
0026 EC62             (    ../cshifts.as):00040                             ldd       2,s       ; load D from stack-relative value 2,s
0028 ED64             (    ../cshifts.as):00041                             std       4,s       ; store D to stack-relative value 4,s
002A ECE4             (    ../cshifts.as):00042                             ldd       ,s        ; load D from memory pointed to by S
002C 3264             (    ../cshifts.as):00043                             leas      4,s       ; adjust S using 4,s
