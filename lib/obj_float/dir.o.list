     0086             (        ../dir.as):00007         I_ChgDir            equ       $86       ; define constant as $86
                      (        ../dir.as):00008         
                      (        ../dir.as):00009         _chdir              EXPORT              ; export this symbol
                      (        ../dir.as):00010         _chxdir             EXPORT              ; export this symbol
