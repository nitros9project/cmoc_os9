0019 EDC1             (     ../memcpy.as):00021                             std       ,u++      ; store D to memory pointed to by U+, then advance U+
001B 301F             (     ../memcpy.as):00022                             leax      -1,x      ; compute effective address into X from -1,x
001D 26F8             (     ../memcpy.as):00023                             bne       Loop_01   ; branch if not equal to Loop_01
001F EC66             (     ../memcpy.as):00024         BranchTarget_02     ldd       6,s       ; load D from stack-relative value 6,s
