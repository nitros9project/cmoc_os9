0002 EE66             (     ../memcpy.as):00009                             ldu       6,s       ; load U from stack-relative value 6,s
0004 10AE68           (     ../memcpy.as):00010                             ldy       8,s       ; load Y from stack-relative value 8,s
0007 EC6A             (     ../memcpy.as):00011                             ldd       10,s      ; load D from stack-relative value 10,s
