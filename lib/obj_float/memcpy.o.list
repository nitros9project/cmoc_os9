000A 56               (     ../memcpy.as):00013                             rorb                ; rotate B right through carry
000B 1F01             (     ../memcpy.as):00014                             tfr       d,x       ; transfer D,X
000D 2404             (     ../memcpy.as):00015                             bcc       BranchTarget_01 ; branch if carry is clear to BranchTarget_01
000F A6A0             (     ../memcpy.as):00016                             lda       ,y+       ; load A from memory pointed to by Y, then advance Y
0011 A7C0             (     ../memcpy.as):00017                             sta       ,u+       ; store A to memory pointed to by U, then advance U
0013 AF7E             (     ../memcpy.as):00018         BranchTarget_01     stx       -2,s      ; store X to stack-relative value -2,s
0015 2708             (     ../memcpy.as):00019                             beq       BranchTarget_02 ; branch if equal/zero to BranchTarget_02
