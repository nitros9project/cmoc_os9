0000 3440             (     ../mktemp.as):00011                             pshs      u         ; save U on the hardware stack
0002 EE64             (     ../mktemp.as):00012                             ldu       4,s       ; load U from stack-relative value 4,s
0004                  (     ../mktemp.as):00013         L_mktemp_scan
0004 E6C0             (     ../mktemp.as):00014                             ldb       ,u+       ; load B from memory pointed to by U, then advance U
