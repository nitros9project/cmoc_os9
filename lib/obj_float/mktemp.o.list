0008 C158             (     ../mktemp.as):00016                             cmpb      #'X
000A 26F8             (     ../mktemp.as):00017                             bne       L_mktemp_scan ; branch if not equal to L_mktemp_scan
000C 335F             (     ../mktemp.as):00018                             leau      -1,u      ; compute effective address into U from -1,u
000E 3440             (     ../mktemp.as):00019                             pshs      u         ; save U on the hardware stack
0010 CC0005           (     ../mktemp.as):00020                             ldd       #5        ; load D from immediate value 5
0013                  (     ../mktemp.as):00021         L_mktemp_zero
0013 A7C0             (     ../mktemp.as):00022                             sta       ,u+       ; store A to memory pointed to by U, then advance U
0015 5A               (     ../mktemp.as):00023                             decb                ; decrement B
0016 26FB             (     ../mktemp.as):00024                             bne       L_mktemp_zero ; branch if not equal to L_mktemp_zero
0018 3540             (     ../mktemp.as):00025                             puls      u         ; restore U from the hardware stack
001A 170000           (     ../mktemp.as):00026                             lbsr      _getpid   ; long branch to subroutine to _getpid
001D 3446             (     ../mktemp.as):00027                             pshs      d,u       ; save D,U on the hardware stack
001F 170000           (     ../mktemp.as):00028                             lbsr      _itoa     ; long branch to subroutine to _itoa
