001B AE66             (       ../puts.as):00026                             ldx       6,s       ; load X from stack-relative value 6,s
001D 3416             (       ../puts.as):00027                             pshs      d,x       ; save D,X on the hardware stack
001F 2005             (       ../puts.as):00028                             bra       L_fputs_loop ; branch unconditionally to L_fputs_loop
