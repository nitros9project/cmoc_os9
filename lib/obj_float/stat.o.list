                      (       ../stat.as):00002         _setstat            EXPORT              ; export generic SetStat wrapper
                      (       ../stat.as):00003         
                      (       ../stat.as):00004         _os9err             EXTERNAL            ; common OS-9 error return helper
                      (       ../stat.as):00005         _sysret             EXTERNAL            ; common system-call return helper
                      (       ../stat.as):00006         
     008D             (       ../stat.as):00007         I_GetStt            equ       $8D       ; OS-9 GetStat system call
     008E             (       ../stat.as):00008         I_SetStt            equ       $8E       ; OS-9 SetStat system call
     00D0             (       ../stat.as):00009         E_UnkSvc            equ       $D0       ; unknown service error code
     0001             (       ../stat.as):00010         SS_Ready            equ       $01       ; path ready state query
     0002             (       ../stat.as):00011         SS_Size             equ       $02       ; file size query/set
     0003             (       ../stat.as):00012         SS_Reset            equ       $03       ; reset device/path state
     0004             (       ../stat.as):00013         SS_WTrk             equ       $04       ; write-track style command
     0005             (       ../stat.as):00014         SS_Pos              equ       $05       ; current file position query
     0006             (       ../stat.as):00015         SS_EOF              equ       $06       ; end-of-file query
     000A             (       ../stat.as):00016         SS_Frz              equ       $0A       ; freeze device command
     000B             (       ../stat.as):00017         SS_SPT              equ       $0B       ; set sectors-per-track style command
     000C             (       ../stat.as):00018         SS_SQD              equ       $0C       ; sequence-down command
     000D             (       ../stat.as):00019         SS_DCmd             equ       $0D       ; device command with register block
     000E             (       ../stat.as):00020         SS_DevNm            equ       $0E       ; device name query
     000F             (       ../stat.as):00021         SS_FD               equ       $0F       ; file descriptor sector query/set
     0010             (       ../stat.as):00022         SS_Ticks            equ       $10       ; tick count status
     0011             (       ../stat.as):00023         SS_Lock             equ       $11       ; lock status command
     0014             (       ../stat.as):00024         SS_BlkRd            equ       $14       ; block read command
     0015             (       ../stat.as):00025         SS_BlkWr            equ       $15       ; block write command
     0019             (       ../stat.as):00026         SS_ELog             equ       $19       ; error log command
     001A             (       ../stat.as):00027         SS_SSig             equ       $1A       ; send signal command
     001B             (       ../stat.as):00028         SS_Relea            equ       $1B       ; release command
