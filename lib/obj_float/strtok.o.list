0014 170000           (     ../strtok.as):00021                             lbsr      _strspn   ; long branch to subroutine to _strspn
0017 3264             (     ../strtok.as):00022                             leas      4,s       ; adjust S using 4,s
0019 33CB             (     ../strtok.as):00023                             leau      d,u       ; compute effective address into U from d,u
001B E6C4             (     ../strtok.as):00024                             ldb       ,u        ; load B from memory pointed to by U
001D 271B             (     ../strtok.as):00025                             beq       BranchTarget_02 ; branch if equal/zero to BranchTarget_02
001F EFE4             (     ../strtok.as):00026                             stu       ,s        ; store U to memory pointed to by S
0021 AE68             (     ../strtok.as):00027                             ldx       8,s       ; load X from stack-relative value 8,s
